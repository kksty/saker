# runtime data
.cyber/
/data/
/cases/
/logs/
*.db
*.db-shm
*.db-wal
/.sock.lock
# Legacy test fixture output; tests now persist manifests in their TempDir.
/internal/api/project.json

# build output（bin/ 不入库；也可以直接用 go run 从源码运行）
/bin/
# 本仓库不内置 harness 源码；单独 checkout 请放 .build/ 或仓库外，这里只作防误提交。
# `/harness` (no trailing slash) also matches a local junction/symlink to a
# harness checkout, which Linux git otherwise reports as an untracked file.
/harness
/harness/
/.build/
*.exe

# 前端依赖（构建产物 internal/web/static 要入库：go:embed 读它）
node_modules/
.pnpm-store/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# 本地运行备份 / operator 的 harness 配置（可能含凭据），不入库
/data.bak*/
/platform.yaml

# 本地草稿与命令输出（日志、临时脚本、快照），不入库
/tmp/

# 运行数据快照（含令牌/证据/客户数据，绝不入库）
/data.zip
/data*.zip
*.twproj
/.tmp/

# 实例级世界知识（运行期发布/候选，可能含操作员凭据），绝不入库
/data/kb/entries/
/data/kb/candidates/
/data/kb/builtin/

# 构建产物与运行日志（tw 可执行文件、gate 临时 bin、启动日志）
/_build-artifacts/

# 本机 agent 指令文件（harness 读取，不是随仓库发布的文档），不同机器内容不同
/AGENTS.md

# 本机协作工具的私有笔记（规划、命名讨论、待办），不进仓库
/.workbuddy/
